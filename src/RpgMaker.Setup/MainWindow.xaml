<Window x:Class="RpgMaker.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RPG Maker 图片阅读器 - 安装"
        Width="620"
        Height="480"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="BackButton" Content="上一步" Width="88" Height="32" Margin="0,0,8,0" Click="Back_Click" />
      <Button x:Name="NextButton" Content="下一步" Width="88" Height="32" Margin="0,0,8,0" Click="Next_Click" IsDefault="True" />
      <Button x:Name="CancelButton" Content="取消" Width="88" Height="32" Click="Cancel_Click" IsCancel="True" />
    </StackPanel>

    <Grid>
      <!-- Welcome -->
      <StackPanel x:Name="PageWelcome" Visibility="Collapsed">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="安装 RPG Maker 图片阅读器" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="本向导将引导你完成安装。你可以指定程序文件的存放路径，并选择是否注册资源管理器缩略图等选项。" />
        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#555"
                   Text="默认安装到当前用户目录，一般不需要管理员权限。若勾选「注册缩略图」，安装过程中可能会弹出 UAC 提权。" />
      </StackPanel>

      <!-- Path -->
      <StackPanel x:Name="PagePath" Visibility="Collapsed">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="选择安装路径" />
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="下载/安装后的程序文件将放置在下面的目录中（可自行修改）：" />
        <DockPanel Margin="0,16,0,0">
          <Button DockPanel.Dock="Right" Content="浏览…" Width="72" Height="30" Margin="8,0,0,0" Click="Browse_Click" />
          <TextBox x:Name="InstallPathBox" Height="30" VerticalContentAlignment="Center" Padding="6,0" />
        </DockPanel>
        <TextBlock Margin="0,10,0,0" Foreground="#666" FontSize="12"
                   Text="建议路径示例：%LocalAppData%\Programs\RpgMakerImageViewer" />
        <TextBlock x:Name="OverwriteHint" Margin="0,10,0,0" Foreground="#0B6E4F" FontSize="12"
                   TextWrapping="Wrap" Visibility="Collapsed"
                   Text="检测到该目录已有本软件，继续将执行覆盖安装（更新文件，保留快捷方式/关联可按选项重写）。" />
      </StackPanel>

      <!-- Options -->
      <StackPanel x:Name="PageOptions" Visibility="Collapsed">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="安装配置项" />
        <TextBlock Margin="0,10,0,12" Text="请选择需要启用的选项：" />
        <CheckBox x:Name="OptDesktop" Content="创建桌面快捷方式" IsChecked="True" Margin="0,4" />
        <CheckBox x:Name="OptStartMenu" Content="创建开始菜单快捷方式" IsChecked="True" Margin="0,4" />
        <CheckBox x:Name="OptAssoc" Content="关联双击打开（.rpgmvp / .png_ 像普通图片一样打开）" IsChecked="True" Margin="0,4" />
        <CheckBox x:Name="OptShell" Content="注册资源管理器缩略图（大图标预览，可能需要管理员权限）" Margin="0,4" />
        <CheckBox x:Name="OptLaunch" Content="安装完成后启动程序" IsChecked="True" Margin="0,4" />
        <TextBlock Margin="0,10,0,0" Foreground="#666" FontSize="12" TextWrapping="Wrap"
                   Text="解密对齐 RPG-Maker-MV-Decrypter：图片可无密钥还原 PNG 头。建议勾选「关联双击打开」。" />
      </StackPanel>

      <!-- Progress -->
      <StackPanel x:Name="PageProgress" Visibility="Collapsed">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="正在安装…" />
        <ProgressBar x:Name="ProgressBar" Height="18" Margin="0,16,0,0" IsIndeterminate="True" />
        <ScrollViewer Height="260" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="LogText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
        </ScrollViewer>
      </StackPanel>

      <!-- Done -->
      <StackPanel x:Name="PageDone" Visibility="Collapsed">
        <TextBlock x:Name="DoneTitle" FontSize="20" FontWeight="SemiBold" Text="安装完成" />
        <TextBlock x:Name="DoneBody" Margin="0,12,0,0" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Uninstall confirm -->
      <StackPanel x:Name="PageUninstall" Visibility="Collapsed">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="卸载 RPG Maker 图片阅读器" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="将移除程序文件、快捷方式，并尽量注销缩略图扩展。确定继续吗？" />
        <TextBlock x:Name="UninstallPathText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#555" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
