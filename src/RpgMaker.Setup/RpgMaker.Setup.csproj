<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RpgMakerImageViewer.Setup</AssemblyName>
    <Product>RPG Maker 图片阅读器安装程序</Product>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RpgMaker.Install\RpgMaker.Install.csproj" />
  </ItemGroup>

  <!-- Filled by tools/publish-release.ps1 before single-file Setup publish. -->
  <ItemGroup Condition="Exists('embedded\payload.zip')">
    <EmbeddedResource Include="embedded\payload.zip" LogicalName="payload.zip" />
  </ItemGroup>

</Project>
